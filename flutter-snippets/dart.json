{
  "Stateless Widget": {
    "prefix": "stless",
    "body": [
      "class ${1:MyWidget} extends StatelessWidget {",
      "  const $1({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return ${2:Container()};",
      "  }",
      "}"
    ],
    "description": "StatelessWidget"
  },
  "Stateful Widget": {
